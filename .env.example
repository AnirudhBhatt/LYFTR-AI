# Comma-separated LLM API key pool (at least 2 keys; key_1, key_2, ... in order)
LLM_API_KEYS=your-gemini-api-key-1,your-gemini-api-key-2

# SQLite storage path (mounted at /data in Docker)
DATABASE_URL=sqlite:////data/app.db

# Comma-separated allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000

# Enable X-Simulate-Failure test hook (true/false)
ENABLE_FAILURE_SIMULATION=true

# Optional LiteLLM configuration
LLM_MODEL=gemini/gemini-2.0-flash
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise AI assistant.
CACHE_TYPE=local
CACHE_DIR=/data/litellm_cache

# Frontend build-time backend URL
VITE_API_URL=http://localhost:8000
